# Supabase (optional — if not set, only local SQLite is used)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Auth store directory (where QR login session is persisted)
AUTH_DIR=./auth_store

# SQLite database path (local backup, always active)
SQLITE_PATH=./messages.db

# Log level (debug, info, warn, error)
LOG_LEVEL=info
